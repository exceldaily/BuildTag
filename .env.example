# =============================================================================
# BuildTag environment
# =============================================================================
# Copy to .env.local for development. On Vercel, add each as a project env var.

# --- Supabase (public: these ship in the browser bundle) ---------------------
# The anon/publishable key maps to the `anon` role, which has NO table
# privileges in the buildtag schema. Everything public goes through
# security-definer functions. Never put the service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# --- Site ---------------------------------------------------------------------
# Absolute origin used in QR codes, OpenGraph tags, sitemap and canonical URLs.
# QR codes encode https://<this-origin>/s/<CODE>. Set it to your production
# domain before printing any decals.
NEXT_PUBLIC_SITE_URL="http://localhost:3020"

# --- Server-only secrets ------------------------------------------------------
# HMAC secret for anonymous visitor keys (likes, report throttling).
# Generate: openssl rand -base64 32
BUILDTAG_VISITOR_SECRET="change-me-to-a-long-random-string"

# --- Admin --------------------------------------------------------------------
# Comma-separated emails that see the Admin link in the dashboard nav.
# Authorization itself is the buildtag.admins table (see README "Admin setup").
ADMIN_EMAILS=""

# --- Optional: scripts only ---------------------------------------------------
# Used by `pnpm rls:test` (creates throwaway users) and `pnpm seed:demo`.
# The application never reads this value.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional: payments + fulfillment ----------------------------------------
# Stripe. STRIPE_SECRET_KEY turns on card checkout for decal orders; the two
# price ids turn on Pro ($5/mo, $50/yr). The webhook secret comes from the
# endpoint you register at https://<your-domain>/api/stripe/webhook.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO_YEARLY=""
# Random string shared with buildtag.private_settings (key billing_token) so the
# webhook can write orders/subscriptions without a service-role key.
BUILDTAG_INTERNAL_TOKEN=""
# Fulfillment provider registered in src/lib/fulfillment ("manual" = admin queue).
FULFILLMENT_PROVIDER="manual"
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Order operations -----------------------------------------------------------
# Transactional email (Resend). Leave empty to skip sending; orders are never
# blocked by email. FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY=""
FROM_EMAIL="BuildTags <orders@buildtags.app>"
# Where new-order / artwork-issue alerts go.
ORDER_NOTIFICATION_EMAIL=""
# Reserved for automated manufacturer submission. Keep false: every order is reviewed by hand.
AUTO_SUBMIT_TO_FULFILLMENT="false"
