{
  "name": "buildtag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3020",
    "build": "next build",
    "start": "next start --port 3020",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "rls:test": "tsx --env-file=.env.local scripts/rls-test.ts",
    "icons": "node scripts/make-icons.mjs",
    "qr:validate": "tsx scripts/qr-validate.ts",
    "og": "tsx scripts/make-og.ts",
    "test": "tsx --test tests/orders.test.ts tests/business.test.ts tests/landing.test.ts tests/legal.test.ts",
    "images": "node scripts/fetch-images.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "opentype.js": "^1.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "potrace": "^2.1.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "BuildTag - a digital build sheet for your car, connected to one permanent QR decal. Scan the build.",
  "engines": {
    "node": ">=20.11.0"
  }
}
